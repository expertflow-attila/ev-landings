---
import "../styles/global.css";
import products from "../data/products.json";

interface Props {
  productSlug: string;
  title: string;
  description: string;
}

const { productSlug, title, description } = Astro.props;

const productList = Object.values(products as Record<string, any>).sort((a, b) => a.order - b.order);
---
<!doctype html>
<html lang="hu" data-product={productSlug}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="author" content="Expert Flow" />
    <meta name="theme-color" content="#0a0a0c" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Expert Flow" />
    <meta property="og:locale" content="hu_HU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="alternate" hreflang="hu" href={`https://ev-landings.vercel.app/${productSlug === "overview" ? "" : productSlug}`} />
    <link rel="alternate" hreflang="x-default" href={`https://ev-landings.vercel.app/${productSlug === "overview" ? "" : productSlug}`} />
    <link rel="canonical" href={`https://ev-landings.vercel.app/${productSlug === "overview" ? "" : productSlug}`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a href="#main" class="skip-link">Ugrás a tartalomhoz</a>

    <div class="bg-fx-glow-tl" aria-hidden="true"></div>
    <div class="bg-fx-vignette" aria-hidden="true"></div>
    <div class="bg-fx-grain" aria-hidden="true"></div>

    <main id="main" class="shell">

      <header>
        <div class="g g-header" style="display: grid;">
          <a href="/" class="gc gc-link" aria-label="Expert Flow — főoldal">
            <span class="brand-logo">
              <b>Expert</b><b>Flow</b>
            </span>
          </a>
          <a href="https://expert-flow-agents.vercel.app" target="_blank" rel="noopener" class="gc gc-link">
            <span class="label-sm with-arrow">Ügynökök</span>
          </a>
          <a href="https://github.com/expertflow-attila" target="_blank" rel="noopener" class="gc gc-link">
            <span class="label-sm with-arrow">GitHub</span>
          </a>
          <div class="gc">
            <span class="label-sm">Csatornák</span>
            <div class="socials-row">
              <a href="https://www.youtube.com/@attilanagy23" target="_blank" rel="noopener" aria-label="YouTube">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
              </a>
              <a href="https://github.com/expertflow-attila" target="_blank" rel="noopener" aria-label="GitHub">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
              </a>
            </div>
          </div>
          <div class="gc">
            <span class="label-sm">Téma</span>
            <button type="button" class="theme-toggle dark" aria-label="Téma váltás (vizuális)" data-theme-toggle>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/></svg>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
              <span class="knob"></span>
            </button>
          </div>
        </div>

        <div class="mobile-bar">
          <a href="/" aria-label="Főoldal">
            <span class="brand-logo" style="font-size: 26px;">
              <b>Expert</b><b>Flow</b>
            </span>
          </a>
          <button type="button" class="theme-toggle dark" aria-label="Téma váltás" data-theme-toggle>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/></svg>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            <span class="knob"></span>
          </button>
        </div>

        <nav class="g g-tabs" aria-label="Termékek">
          {productList.map((p) => (
            <a
              href={p.slug === "overview" ? "/" : `/${p.slug}`}
              class={`gc gc-link gc-tab${p.slug === productSlug ? " active" : ""}`}
              aria-current={p.slug === productSlug ? "page" : undefined}
            >
              <span class="tab-name">{p.name}</span>
              <span class="tab-role">{p.role}</span>
            </a>
          ))}
        </nav>
      </header>

      <slot />

      <footer class="g g-foot foot" style="margin-top: 0;">
        <div class="gc">
          <span class="label-sm">EV-Landings</span>
          <span class="label-sm accent">v0.1.0</span>
        </div>
        <div class="gc">
          <a href="https://expert-flow-agents.vercel.app" target="_blank" rel="noopener" class="label-sm with-arrow">Ügynökök</a>
        </div>
        <div class="gc">
          <a href="https://expertflow.hu" target="_blank" rel="noopener" class="label-sm with-arrow">expertflow.hu</a>
        </div>
        <div class="gc">
          <span class="label-sm dim">© 2026 · MIT License</span>
        </div>
      </footer>
    </main>

    <script>
      // Copy buttons
      document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const target = btn.getAttribute("data-copy");
          if (!target) return;
          const el = document.querySelector(target) as HTMLElement | null;
          if (!el) return;
          try {
            await navigator.clipboard.writeText(el.innerText.trim());
            const original = btn.textContent;
            btn.classList.add("copied");
            btn.textContent = "Másolva";
            setTimeout(() => {
              btn.textContent = original;
              btn.classList.remove("copied");
            }, 1400);
          } catch (e) {
            console.error("Másolás sikertelen:", e);
          }
        });
      });

      // Theme toggle (visual only)
      document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((btn) => {
        btn.addEventListener("click", () => {
          btn.classList.toggle("dark");
          btn.classList.toggle("light");
        });
      });

      // Terminal animation
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      document.querySelectorAll<HTMLElement>("[data-terminal]").forEach((term) => {
        const script = JSON.parse(term.getAttribute("data-script") || "[]") as Array<{
          type: string;
          text: string;
          ms: number;
        }>;
        const body = term.querySelector(".term-body") as HTMLElement;
        if (!body) return;

        if (reduced) {
          body.innerHTML = script
            .map((s) => `<span class="term-line ${s.type}">${escapeHtml(s.text)}</span>`)
            .join("");
          return;
        }

        let i = 0;
        const cursor = document.createElement("span");
        cursor.className = "blink";
        body.appendChild(cursor);

        function next() {
          if (i >= script.length) return;
          const s = script[i++];
          const line = document.createElement("span");
          line.className = `term-line ${s.type}`;
          line.textContent = s.text;
          body.insertBefore(line, cursor);
          setTimeout(next, s.ms);
        }
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              setTimeout(next, 400);
              io.disconnect();
            }
          });
        }, { threshold: 0.3 });
        io.observe(term);
      });

      function escapeHtml(s: string) {
        return s.replace(/[&<>"']/g, (c) =>
          ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c] || c)
        );
      }
    </script>
  </body>
</html>

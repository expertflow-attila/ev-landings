---
import "../styles/global.css";
import products from "../data/products.json";

interface Props {
  productSlug: string;
  title: string;
  description: string;
}

const { productSlug, title, description } = Astro.props;

const productList = Object.values(products as Record<string, any>).sort((a, b) => a.order - b.order);

const siteOrigin = Astro.site?.toString().replace(/\/$/, "") ?? "https://ev-landings.vercel.app";
const canonical = `${siteOrigin}${productSlug === "overview" ? "/" : `/${productSlug}`}`;
const ogImage = `${siteOrigin}/og-${productSlug}.svg`;

const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Solo Business",
  "url": "https://expertflow.hu",
  "logo": `${siteOrigin}/og-overview.svg`,
  "sameAs": [
    "https://github.com/expertflow-attila",
    "https://github.com/Expert-Flow"
  ]
};
---
<!doctype html>
<html lang="hu" data-product={productSlug}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="author" content="Solo Business" />
    <meta name="theme-color" content="#0a0a0c" />
    <link rel="canonical" href={canonical} />

    <!-- Font preconnect (Google Fonts) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Solo Business" />
    <meta property="og:locale" content="hu_HU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />

    <link rel="alternate" hreflang="hu" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
  </head>
  <body>
    <a href="#main" class="skip-link">Ugrás a tartalomhoz</a>

    <div class="bg-fx-glow-tl" aria-hidden="true"></div>
    <div class="bg-fx-vignette" aria-hidden="true"></div>
    <div class="bg-fx-grain" aria-hidden="true"></div>

    <main id="main" class="shell">

      <header>
        <div class="g g-header">
          <a href="/" class="gc gc-link" aria-label="Solo Business — főoldal">
            <span class="brand-logo"><b>Solo Business</b></span>
          </a>
          <a href="https://expert-flow-agents.vercel.app" target="_blank" rel="noopener" class="gc gc-link">
            <span class="label-sm with-arrow">Ügynökök</span>
          </a>
          <a href="https://github.com/Expert-Flow" target="_blank" rel="noopener" class="gc gc-link">
            <span class="label-sm with-arrow">GitHub</span>
          </a>
          <a href="https://expertflow.hu" target="_blank" rel="noopener" class="gc gc-link">
            <span class="label-sm with-arrow">expertflow.hu</span>
          </a>
        </div>

        <div class="mobile-bar">
          <a href="/" class="mobile-bar-brand" aria-label="Főoldal">
            <span class="brand-logo brand-logo--sm"><b>Solo Business</b></span>
          </a>
          <nav class="mobile-nav" aria-label="Globális mobil navigáció">
            <a href="https://expert-flow-agents.vercel.app" target="_blank" rel="noopener" aria-label="Ügynökök">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="7" r="4"/><path d="M3 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2"/><circle cx="17" cy="7" r="4"/></svg>
            </a>
            <a href="https://github.com/Expert-Flow" target="_blank" rel="noopener" aria-label="GitHub">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
            </a>
            <a href="https://expertflow.hu" target="_blank" rel="noopener" aria-label="expertflow.hu">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            </a>
          </nav>
        </div>

        <nav aria-label="Termékek">
          <div class="g g-tabs">
            {productList.map((p) => (
              <a
                href={p.slug === "overview" ? "/" : `/${p.slug}`}
                class={`gc gc-link gc-tab${p.slug === productSlug ? " active" : ""}`}
                aria-current={p.slug === productSlug ? "page" : undefined}
              >
                <span class="tab-name">{p.name}</span>
                <span class="tab-role">{p.role}</span>
              </a>
            ))}
          </div>
        </nav>
      </header>

      <slot />

    </main>

    <footer class="g g-foot foot">
      <div class="gc">
        <span class="label-sm">EV-Landings</span>
        <span class="label-sm accent">v0.1.0</span>
      </div>
      <div class="gc">
        <a href="https://expertflow.hu" target="_blank" rel="noopener" class="label-sm with-arrow">expertflow.hu</a>
      </div>
      <div class="gc">
        <span class="label-sm dim">© 2026 · MIT License</span>
      </div>
    </footer>

    <script>
      // Copy buttons
      document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const target = btn.getAttribute("data-copy");
          if (!target) return;
          const el = document.querySelector(target) as HTMLElement | null;
          if (!el) return;
          try {
            await navigator.clipboard.writeText(el.innerText.trim());
            const original = btn.textContent;
            btn.classList.add("copied");
            btn.textContent = "Másolva";
            setTimeout(() => {
              btn.textContent = original;
              btn.classList.remove("copied");
            }, 1400);
          } catch (e) {
            console.error("Másolás sikertelen:", e);
          }
        });
      });

      // Terminal animation
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      document.querySelectorAll<HTMLElement>("[data-terminal]").forEach((term) => {
        const script = JSON.parse(term.getAttribute("data-script") || "[]") as Array<{
          type: string;
          text: string;
          ms: number;
        }>;
        const body = term.querySelector(".term-body") as HTMLElement;
        if (!body) return;

        if (reduced) {
          body.innerHTML = script
            .map((s) => `<span class="term-line ${s.type}">${escapeHtml(s.text)}</span>`)
            .join("");
          return;
        }

        let i = 0;
        const cursor = document.createElement("span");
        cursor.className = "blink";
        body.appendChild(cursor);

        function next() {
          if (i >= script.length) return;
          const s = script[i++];
          const line = document.createElement("span");
          line.className = `term-line ${s.type}`;
          line.textContent = s.text;
          body.insertBefore(line, cursor);
          setTimeout(next, s.ms);
        }
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              setTimeout(next, 400);
              io.disconnect();
            }
          });
        }, { threshold: 0.3 });
        io.observe(term);
      });

      function escapeHtml(s: string) {
        return s.replace(/[&<>"']/g, (c) =>
          ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c] || c)
        );
      }
    </script>
  </body>
</html>
